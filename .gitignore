# --- Python ---
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
*.egg-info/
build/
dist/

# --- Virtual environment ---
.venv/
venv/
env/

# --- Training data (large, fetched/generated separately) ---
datasets/

# --- Model weights / exported artifacts (large binaries) ---
weights/*
*.pt
*.pth
*.onnx
*.engine
*.torchscript

# Keep the two deployed checkpoints so a fresh clone can run inference
!weights/best.pt
!weights/drone_best.pt

# --- Generated runs / logs / benchmark output ---
runs/
logs/
*.log

# --- Video / media (large, generated or captured footage) ---
*.mp4
*.avi
*.mov
*.mkv

# Test clips are regenerated by tests/make_clips.py

# --- Scratch reports ---
*.txt
!requirements.txt

# --- Editor / OS cruft ---
.DS_Store
Thumbs.db
.vscode/
.idea/
